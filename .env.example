# Copy component-specific examples instead of placing secrets in this root file.
# Frontend: frontend/.env.example
# Backend: backend/.env.example
# Local services: use these names with docker-compose.yml or an equivalent installation.
POSTGRES_DB=stocksense
POSTGRES_USER=stocksense_app
POSTGRES_PASSWORD=replace_with_a_long_local_password
N8N_BASIC_AUTH_USER=stocksense_admin
N8N_BASIC_AUTH_PASSWORD=replace_with_a_long_local_password
N8N_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
GEMINI_API_KEY=configure_securely_do_not_commit
GEMINI_MODEL=gemini-flash-lite-latest
BACKEND_INTERNAL_URL=http://host.docker.internal:3000/internal/v1/agent-tools
AGENT_SERVICE_SECRET=must_match_the_backend_agent_service_secret

